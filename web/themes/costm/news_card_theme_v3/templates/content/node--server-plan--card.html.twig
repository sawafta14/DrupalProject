{# node--server-plan--card.html.twig
   بطاقة عرض لخطة الاستضافة (View mode: Card)
   يعتمد على الحقول:
   - field_is_active (Boolean)
   - field_is_featured (Boolean)  => شارة "Most Popular"
   - field_price (Decimal)
   - field_period (List text)     => مثل: monthly / yearly
   - field_features (Formatted long text) => كل سطر ميزة
   - field_ram, field_storage, field_cpu, field_bandwidth (نصوص قصيرة)
#}

{% if node.field_is_active.value %}
  {{ attach_library('news_card_theme/hosting-plans') }}

  {% set url = url('entity.node.canonical', {'node': node.id}) %}

  <article{{ attributes.addClass('sp-card') }}>
    <header class="sp-card__header">
      <h3 class="sp-card__title"><a href="{{ url }}">{{ label }}</a></h3>

      {% if node.field_is_featured.value %}
        <span class="sp-badge">Most Popular</span>
      {% endif %}
    </header>

    <div class="sp-card__price">
      {{ content.field_price }} <span class="sp-period">/ {{ content.field_period }}</span>
    </div>

    <ul class="sp-features">
      {# مواصفات مختصرة (RAM/Storage/CPU/Bandwidth) تظهر كبنود #}
      {% if content.field_ram is not empty %}<li>{{ content.field_ram }}</li>{% endif %}
      {% if content.field_storage is not empty %}<li>{{ content.field_storage }}</li>{% endif %}
      {% if content.field_cpu is not empty %}<li>{{ content.field_cpu }}</li>{% endif %}
      {% if content.field_bandwidth is not empty %}<li>{{ content.field_bandwidth }}</li>{% endif %}

      {# Features نص طويل؛ نقسمه أسطر #}
      {% set features_html = content.field_features|render %}
      {% set features_text = features_html|striptags|trim %}
      {% for line in features_text|split('\n') %}
        {% if line|trim %}<li>{{ line|trim }}</li>{% endif %}
      {% endfor %}
    </ul>

    <a href="{{ url }}" class="sp-btn">Get Started →</a>
  </article>
{% endif %}