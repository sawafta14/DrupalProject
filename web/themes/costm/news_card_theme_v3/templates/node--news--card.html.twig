{# Template for bundle "news" in view mode "card" #}
<article{{ attributes.addClass('nc-card') }}>
  {% set url = url('entity.node.canonical', {'node': node.id}) %}
  {% if content.field_cover is not empty %}
  <a href="{{ url }}" class="nc-card__media">{{ content.field_cover }}</a>
  {% endif %}
  <div class="nc-card__body">
    <div class="nc-card__date">{{ node.field_published_at.value ? node.field_published_at.value|date('M d, Y') : node.created.value|date('M d, Y') }}</div>
    <h3 class="nc-card__title"><a href="{{ url }}">{{ label }}</a></h3>
    <div class="nc-card__excerpt">{{ content.body }}</div>
  </div>
  <div class="nc-card__footer"><a href="{{ url }}" class="nc-btn-link">اقرأ المزيد →</a></div>
</article>