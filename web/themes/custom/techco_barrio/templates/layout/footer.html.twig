{# templates/layout/footer.html.twig #}
<footer class="tc-footer" role="contentinfo" aria-label="Footer">
  <div class="tc-container">
    <div class="tc-footer-inner">
      
      {# ===== Column 1: Logo + Description + Social ===== #}
    <div class="tc-footer-col tc-brand">
  <div class="tc-logo">
    <a href="{{ path('<front>') }}" class="navbar-brand">
      <i class="fas fa-cube"></i> {{ site_name }}
    </a>
  </div>
</div>

        <p class="tc-footer-desc">
          Professional hosting and technology solutions for your business. Fast, secure, and reliable services you can trust.
        </p>
        <div class="tc-social">
          {% for link in social_links %}
            <a href="{{ link.url }}" class="tc-social-link" title="{{ link.title }}" target="_blank" rel="noopener noreferrer">
              <i class="{{ link.icon_class }}" aria-hidden="true"></i>
            </a>
          {% endfor %}
        </div>
      </div>

      {# ===== Column 2: Menus ===== #}
      <div class="tc-footer-col tc-menus">
        <div class="tc-menu-block">
          <h4 class="tc-menu-title">Quick Links</h4>
          <nav class="tc-menu" aria-label="Quick Links">
            {{ footer_menus.quick_links|raw }}
          </nav>
        </div>

        <div class="tc-menu-block">
          <h4 class="tc-menu-title">Resources</h4>
          <nav class="tc-menu" aria-label="Resources">
            {{ footer_menus.resources|raw }}
          </nav>
        </div>
      </div>

      {# ===== Column 3: Newsletter (Webform Block) ===== #}
      <div class="tc-footer-col tc-newsletter">
        <h4 class="tc-menu-title">Stay Updated</h4>
        <p class="tc-news-desc">
          Subscribe to our newsletter for the latest updates and offers.
        </p>
        <div class="tc-news-form">
          {{ newsletter_block_markup|raw }}
        </div>
      </div>

    </div>
  </div>

  {# ===== Bottom Footer Bar ===== #}
  <div class="tc-footer-bottom">
    <div class="tc-container">
      <div class="tc-copy">
        &copy; {{ "now"|date("Y") }} {{ site_name }} — All rights reserved.
      </div>
    </div>
  </div>
</footer>
