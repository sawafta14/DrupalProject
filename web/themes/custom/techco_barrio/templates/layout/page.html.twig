{#
  TechCo Custom Page Template – Override for Bootstrap Barrio
#}

{% set sidebar_first_exists = page.sidebar_first|render|striptags('<img><video><audio><drupal-render-placeholder>')|trim is not empty %}
{% set sidebar_second_exists = page.sidebar_second|render|striptags('<img><video><audio><drupal-render-placeholder>')|trim is not empty %}

<div id="page-wrapper">
  <div id="page">

    {# ========================== HEADER ========================== #}
    <header id="header" class="techco-header bg-white shadow-sm py-3" role="banner">
      <nav{{ navbar_attributes }} class="navbar navbar-expand-lg">
        {% if container_navbar %}
        <div class="container">
        {% endif %}

          {# Logo + branding region #}
          <div class="navbar-brand d-flex align-items-center">
            {{ page.header }}
          </div>

          {# Mobile button #}
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
          </button>

          {# Main menu #}
          <div class="collapse navbar-collapse" id="mainNav">
            <div class="ms-auto">
              {{ page.primary_menu }}
            </div>

            {% if page.header_form %}
              <div class="ms-lg-3">
                {{ page.header_form }}
              </div>
            {% endif %}
          </div>

        {% if container_navbar %}
        </div>
        {% endif %}
      </nav>
    </header>

    {# ======================= FEATURED TOP ======================= #}
    {% if page.featured_top %}
      <div class="featured-top">
        <aside class="featured-top__inner section {{ container }} clearfix">
          {{ page.featured_top }}
        </aside>
      </div>
    {% endif %}

    {# ========================== MAIN ============================ #}
    <div id="main-wrapper" class="layout-main-wrapper clearfix">

      {# ==== MAKE FRONT PAGE FULL WIDTH FOR HERO ==== #}
      {% if is_front %}
        <div id="main" class="container-fluid px-0">
      {% else %}
        <div id="main" class="{{ container }}">
      {% endif %}

        {{ page.breadcrumb }}

        <div class="row row-offcanvas row-offcanvas-left clearfix">
          <main{{ content_attributes }}>
            <section class="section">
              <a href="#main-content" id="main-content" tabindex="-1"></a>
              {{ page.content }}
            </section>
          </main>

          {% if sidebar_first_exists %}
            <div{{ sidebar_first_attributes }}>
              <aside class="section" role="complementary">
                {{ page.sidebar_first }}
              </aside>
            </div>
          {% endif %}

          {% if sidebar_second_exists %}
            <div{{ sidebar_second_attributes }}>
              <aside class="section" role="complementary">
                {{ page.sidebar_second }}
              </aside>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    {# ========================= FOOTER =========================== #}
    <footer class="techco-footer bg-light mt-5 py-5">
      <div class="{{ container }}">

        {% if page.footer_first or page.footer_second or page.footer_third %}
          <div class="row g-4 py-4">

            <div class="col-md-4">
              {{ page.footer_first }}
            </div>

            <div class="col-md-4">
              {{ page.footer_second }}
            </div>

            <div class="col-md-4">
              {{ page.footer_third }}
            </div>

          </div>
        {% endif %}

        {% if page.footer_fifth %}
          <div class="text-center small text-muted pt-4 border-top">
            {{ page.footer_fifth }}
          </div>
        {% endif %}

      </div>
    </footer>

  </div>
</div>
