<?php

/**
 * Implements hook_preprocess_page().
 */
function techco_barrio_preprocess_page(array &$variables) {
  // Attach only the footer styling (no programmatic footer content).
  $variables['#attached']['library'][] = 'techco_barrio/footer';
}

/**
 * Implements hook_page_attachments().
 */
function techco_barrio_page_attachments(array &$attachments) {
  $route_name = \Drupal::routeMatch()->getRouteName();

  // Load admin and layout builder assets when editing layouts.
  if (str_contains($route_name, 'layout_builder')) {
    $attachments['#attached']['library'][] = 'core/drupal.layout_builder';
    $attachments['#attached']['library'][] = 'core/drupal.dialog';
    $attachments['#attached']['library'][] = 'core/drupal.dialog.off_canvas';
    $attachments['#attached']['library'][] = 'core/drupal.ajax';
    $attachments['#attached']['library'][] = 'core/drupalSettings';
  }
}
