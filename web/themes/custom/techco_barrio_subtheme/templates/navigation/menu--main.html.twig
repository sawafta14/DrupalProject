{% import _self as menus %}
{% macro render_menu(items, attributes, menu_level) %}
  {% if items %}
    {% set ul_classes = menu_level == 0 ? ['navbar-nav','me-auto','mb-2','mb-lg-0','gap-lg-2'] : ['dropdown-menu'] %}
    <ul{{ attributes.addClass(ul_classes) }}>
      {% for item in items %}
        {% set classes = ['nav-item', item.in_active_trail ? 'active'] %}
        {% if item.below %}
          <li{{ item.attributes.addClass(classes)|without('role') }}>
            <a href="{{ item.url }}" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
              {{ item.title }}
            </a>
            {{ menus.render_menu(item.below, attributes.removeClass(ul_classes), menu_level + 1) }}
          </li>
        {% else %}
          <li{{ item.attributes.addClass(classes)|without('role') }}>
            <a href="{{ item.url }}" class="nav-link">{{ item.title }}</a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}

{{ menus.render_menu(items, attributes, 0) }}
