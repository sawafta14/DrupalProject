<div class="news-landing">

  <h1>Latest News</h1>
<div class="test-marker">THIS IS TWIG TEMPLATE</div>

  <div class="news-list">
    {% for item in items %}
      <div class="news-item">
        <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
        <small>{{ item.date|date("F j, Y") }}</small>
      </div>
    {% else %}
      <p>No news found.</p>
    {% endfor %}
  </div>

</div>
