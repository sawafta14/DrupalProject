{# themes/custom/techco_server_plan/templates/node/node--server-plan--card.html.twig #}
{{ attach_library('techco_server_plan/pricing-card') }}


{% set featured = content.field_is_featured is defined and content.field_is_featured %}

<article{{ attributes.addClass(['tc-card','h-100', featured ? 'tc-featured' : '']) }}>
  <div class="tc-card-body d-flex flex-column">
    <div class="tc-card-head d-flex align-items-start justify-content-between">
      <h3 class="tc-title mb-0">{{ label }}</h3>
      {% if featured %}
        <span class="tc-badge">Most Popular</span>
      {% endif %}
    </div>

    <div class="tc-price my-2">
      <div class="tc-amount">
        {{ content.field_price }}
      </div>
      <div class="tc-period">/ {{ content.field_period }}</div>
    </div>

    <ul class="tc-features mb-4">
      <li><span>CPU</span><strong>{{ content.field_cpu }}</strong></li>
      <li><span>RAM</span><strong>{{ content.field_ram }}</strong></li>
      <li><span>Storage</span><strong>{{ content.field_storage }}</strong></li>
      <li><span>Bandwidth</span><strong>{{ content.field_bandwidth }}</strong></li>
    </ul>

    <div class="mt-auto">
      <a href="{{ url }}" class="tc-btn w-100">Get Started →</a>
    </div>
  </div>
</article>
